# Server Configuration
PORT=5000
NODE_ENV=development

# Database
MONGODB_URI=mongodb://localhost:27017/ai-interview-platform
# Or use MongoDB Atlas:
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/ai-interview-platform

# JWT Secret
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRE=7d

# Groq API — Free. Get your key at https://console.groq.com
GROQ_API_KEY=your-groq-api-key-here
# Groq model to use. Check supported models at https://console.groq.com/docs/models
# Currently supported production models: openai/gpt-oss-20b, openai/gpt-oss-120b
GROQ_MODEL=openai/gpt-oss-20b

# File Upload
MAX_FILE_SIZE=5242880
UPLOAD_PATH=./uploads

# CORS
FRONTEND_URL=http://localhost:3000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
